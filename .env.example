# Amadeus for Developers — Self-Service tier (test.api.amadeus.com)
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Necessário apenas na Vercel (dashboard), para o dashboard commitar mudanças de config.json.
# PAT com escopo "repo" (fine-grained: Contents read/write no repositório).
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main
